{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "@/lib/utils": ["./src/lib/utils.ts"],
      "@/registry/*": ["./registry/*"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src", "registry", "vite.config.ts"]
}
